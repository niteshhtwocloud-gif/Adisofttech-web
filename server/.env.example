# Backend server listening port.
PORT=5000
# Node runtime environment.
NODE_ENV=development

# MongoDB Atlas connection URI.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>

# Secret key used to sign JWT authentication tokens.
JWT_SECRET=your_secret_here
# JWT authentication token expiration time.
JWT_EXPIRES_IN=7d

# Allowed cross-origin resource sharing domains.
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# SMTP user email address for dispatching notifications.
EMAIL_USER=
# SMTP application password for the email service.
EMAIL_PASS=
# Destination address for receiving incoming contact enquiries.
EMAIL_TO=

# Cloudflare Turnstile secret key for server-side verification.
TURNSTILE_SECRET_KEY=

# Initial administrator account email address.
ADMIN_EMAIL=
# Initial administrator account password.
ADMIN_PASSWORD=
