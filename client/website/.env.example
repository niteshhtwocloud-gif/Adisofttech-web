# Express backend REST API base URL.
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Cloudflare Turnstile public site key for client-side CAPTCHA verification.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key_here

# Public canonical website domain URL.
SITE_URL=https://www.adisofttech.com
